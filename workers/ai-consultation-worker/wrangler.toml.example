name = "yingchuang-ai-consultation"
main = "src/index.js"
compatibility_date = "2026-07-03"

[vars]
DEEPSEEK_BASE_URL = "https://api.deepseek.com"
DEEPSEEK_MODEL = "deepseek-v4-pro"
ALLOWED_ORIGIN = "https://your-yingchuang-site.example,http://localhost:3001"

# Add the API key as a secret, never in this file:
# wrangler secret put DEEPSEEK_API_KEY
